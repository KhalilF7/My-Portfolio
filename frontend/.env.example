# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Public, safe to expose: identifies the dataset the site reads from.
REACT_APP_SANITY_PROJECT_ID=your_project_id
REACT_APP_SANITY_DATASET=production

# NOTE: the Sanity write token is NOT set here.
# It belongs only in Netlify > Site settings > Environment variables,
# as SANITY_WRITE_TOKEN (no REACT_APP_ prefix, so it stays server-side).
