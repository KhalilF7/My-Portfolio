# Copy this file to .env.local and fill in the values, then run:
#   node scripts/add-seo-revolution-experience.js
#
# .env.local is git-ignored. Keeping the token here rather than on the command
# line also keeps it out of your shell history.

SANITY_PROJECT_ID=avrdne9e
SANITY_DATASET=production

# sanity.io/manage -> your project -> API -> Tokens -> Add token (Editor).
SANITY_WRITE_TOKEN=

# HTTP basic auth for the password-protected staging sites.
STAGING_USER=
STAGING_PASS=
